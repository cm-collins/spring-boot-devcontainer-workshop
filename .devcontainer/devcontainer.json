{
    "name": "Spring Boot Dev Container Workshop",
    "build": {
        "dockerfile": "Dockerfile.dev",
        "context": ".."
    },
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "remoteUser": "vscode",
    "mounts": [
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
    ],
    "runArgs": [
        "--group-add=keep-groups"
    ],
    "remoteEnv": {
        "DOCKER_HOST": "unix:///var/run/docker.sock",
        "POSTGRES_HOST": "postgres",
        "POSTGRES_PORT": "5432",
        "POSTGRES_DB": "spring_boot_dev",
        "POSTGRES_USER": "spring_boot",
        "POSTGRES_PASSWORD": "spring_boot_dev_password",
        "SPRING_DATASOURCE_URL": "jdbc:postgresql://postgres:5432/spring_boot_dev",
        "SPRING_DATASOURCE_USERNAME": "spring_boot",
        "SPRING_DATASOURCE_PASSWORD": "spring_boot_dev_password"
    },
    "forwardPorts": [
        8080,
        5432
    ],
    "portsAttributes": {
        "8080": {
            "label": "Spring Boot",
            "onAutoForward": "notify"
        },
        "5432": {
            "label": "PostgreSQL",
            "onAutoForward": "silent"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "vmware.vscode-spring-boot",
                "vscjava.vscode-spring-initializr",
                "vscjava.vscode-gradle",
                "redhat.vscode-yaml",
                "ms-azuretools.vscode-docker"
            ],
            "settings": {
                "java.configuration.updateBuildConfiguration": "automatic",
                "java.compile.nullAnalysis.mode": "automatic",
                "java.configuration.runtimes": [
                    {
                        "name": "JavaSE-21",
                        "path": "/usr/lib/jvm/msopenjdk-current",
                        "default": true
                    }
                ],
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },
    "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
    "postStartCommand": "bash .devcontainer/scripts/start-postgres.sh",
    "postAttachCommand": "bash .devcontainer/scripts/show-devcontainer-summary.sh"
}
